# Copier ce fichier en ".env" et remplir les valeurs.
# NE JAMAIS commiter le vrai fichier ".env".

# Adresse gmail utilisée pour envoyer les mails
GMAIL_ADDRESS=mon.adresse@gmail.com

# Mot de passe d'application Gmail (PAS ton mot de passe normal)
# A generer sur : https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Adresse utilisée par notify_me() pour t'envoyer une notif à toi-même
# (par défaut = GMAIL_ADDRESS si non défini)
GMAIL_NOTIFY_TO=mon.adresse@gmail.com
